  },
  "font": {
    "sans": "Inter, system-ui, sans-serif",
    "display": "\"Instrument Serif\", Georgia, serif"
  },
  "type": {
    "display": { "font": "display", "size": 48, "lineHeight": 56, "mobileSize": 34, "mobileLineHeight": 40, "weight": 400, "accentLine": "italic, color.brand.accent" },
    "h2": { "font": "display", "size": 28, "lineHeight": 34, "weight": 400 },
    "eyebrow": { "font": "sans", "size": 12, "lineHeight": 16, "weight": 600, "letterSpacing": "0.08em", "transform": "uppercase", "color": "color.brand.primary" },
