# Production: supplied through the deployment secret manager.
APP_ENV=production
AUTH_MODE=oidc
APP_ORIGIN=https://docs.example.com
DATABASE_URL=postgresql://docs:REPLACE@db.example.com/docs?sslmode=verify-full
OIDC_ISSUER=https://identity.example.com
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_CLIENT_ID=docs-web
OIDC_AUDIENCE=docs-api
OIDC_SCOPE=openid profile docs:read docs:write
# Register APP_ORIGIN/auth/callback as the public client's exact redirect URI.
# No client secret belongs in the React app.
